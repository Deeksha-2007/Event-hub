erDiagram

    User {
        String  id           PK
        String  name
        String  email        UK
        String  passwordHash
        Role    role
        String  phone
        String  avatar
        DateTime createdAt
        DateTime updatedAt
    }

    Venue {
        String  id         PK
        String  name
        String  address
        String  city
        String  state
        String  country
        String  postalCode
        Int     capacity
        String  amenities
        String  imageUrl
        DateTime createdAt
        DateTime updatedAt
    }

    Event {
        String      id                PK
        String      title
        String      description
        String      category
        String      bannerUrl
        DateTime    startDate
        DateTime    endDate
        String      venueId           FK
        String      organizerId       FK
        Int         totalCapacity
        Int         availableCapacity
        EventStatus status
        DateTime    createdAt
        DateTime    updatedAt
    }

    TicketType {
        String   id                PK
        String   eventId           FK
        String   name
        Float    price
        Int      totalQuantity
        Int      availableQuantity
        String   description
        String   perks
        DateTime createdAt
        DateTime updatedAt
    }

    Booking {
        String        id               PK
        String        bookingReference UK
        String        userId           FK
        String        eventId          FK
        String        ticketTypeId     FK
        Int           quantity
        Float         unitPrice
        Float         totalAmount
        BookingStatus status
        DateTime      cancelledAt
        DateTime      createdAt
        DateTime      updatedAt
    }

    Attendee {
        String   id            PK
        String   bookingId     FK
        String   eventId       FK
        String   userId        FK
        String   ticketTypeId  FK
        String   attendeeName
        String   attendeeEmail
        String   phone
        Boolean  checkInStatus
        DateTime checkInTime
        DateTime createdAt
        DateTime updatedAt
    }

    Payment {
        String        id             PK
        String        bookingId      FK, UK
        String        transactionId  UK
        Float         amount
        String        currency
        PaymentMethod paymentMethod
        PaymentStatus status
        String        paymentDetails
        String        failureReason
        DateTime      createdAt
        DateTime      updatedAt
    }

    Review {
        String   id        PK
        String   eventId   FK
        String   userId    FK
        Int      rating
        String   comment
        DateTime createdAt
        DateTime updatedAt
    }

    %% ─── Relationships ───────────────────────────────────────────────

    %% A User can organise zero or many Events (organizer role)
    User ||--o{ Event        : "organises"

    %% A Venue hosts zero or many Events (venueId is nullable)
    Venue |o--o{ Event       : "hosts"

    %% An Event has one or many TicketTypes
    Event ||--o{ TicketType  : "has ticket tiers"

    %% A User makes zero or many Bookings
    User ||--o{ Booking      : "makes"

    %% An Event has zero or many Bookings
    Event ||--o{ Booking     : "receives"

    %% A TicketType is chosen for zero or many Bookings
    TicketType ||--o{ Booking : "is booked as"

    %% A Booking has exactly one Payment (1-to-1)
    Booking ||--o| Payment   : "is paid via"

    %% A Booking covers one or many Attendees (one per ticket seat)
    Booking ||--o{ Attendee  : "covers"

    %% An Event has zero or many Attendees (denormalised FK for direct lookup)
    Event ||--o{ Attendee    : "is attended by"

    %% A TicketType is associated with zero or many Attendees (denormalised FK)
    TicketType ||--o{ Attendee : "is used by"

    %% A User may optionally be linked to an Attendee seat (nullable)
    User |o--o{ Attendee     : "is recorded as"

    %% A User leaves zero or many Reviews; one review per event per user
    User ||--o{ Review       : "writes"

    %% An Event has zero or many Reviews
    Event ||--o{ Review      : "receives"