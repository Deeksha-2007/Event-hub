generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Attendee {
  id            String     @id
  bookingId     String
  eventId       String
  userId        String?
  ticketTypeId  String
  attendeeName  String
  attendeeEmail String
  phone         String?
  checkInStatus Boolean    @default(false)
  checkInTime   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime
  Booking       Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  Event         Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  TicketType    TicketType @relation(fields: [ticketTypeId], references: [id])
  User          User?      @relation(fields: [userId], references: [id])
}

model Booking {
  id               String        @id
  bookingReference String        @unique
  userId           String
  eventId          String
  ticketTypeId     String
  quantity         Int           @default(1)
  unitPrice        Float
  totalAmount      Float
  status           BookingStatus @default(CONFIRMED)
  cancelledAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  Attendee         Attendee[]
  Event            Event         @relation(fields: [eventId], references: [id])
  TicketType       TicketType    @relation(fields: [ticketTypeId], references: [id])
  User             User          @relation(fields: [userId], references: [id])
  Payment          Payment?
}

model Event {
  id                String       @id
  title             String
  description       String
  category          String       @default("Technology")
  bannerUrl         String?
  startDate         DateTime
  endDate           DateTime
  venueId           String?
  organizerId       String
  totalCapacity     Int
  availableCapacity Int
  status            EventStatus  @default(PUBLISHED)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime
  Attendee          Attendee[]
  Booking           Booking[]
  User              User         @relation(fields: [organizerId], references: [id])
  Venue             Venue?       @relation(fields: [venueId], references: [id])
  Review            Review[]
  TicketType        TicketType[]
}

model Payment {
  id             String        @id
  bookingId      String        @unique
  transactionId  String        @unique
  amount         Float
  currency       String        @default("INR")
  paymentMethod  PaymentMethod @default(UPI)
  status         PaymentStatus @default(SUCCESS)
  paymentDetails String?
  failureReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  Booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id
  eventId   String
  userId    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model TicketType {
  id                String     @id
  eventId           String
  name              String
  price             Float
  totalQuantity     Int
  availableQuantity Int
  description       String?
  perks             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime
  Attendee          Attendee[]
  Booking           Booking[]
  Event             Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model User {
  id           String     @id
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  phone        String?
  avatar       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Attendee     Attendee[]
  Booking      Booking[]
  Event        Event[]
  Review       Review[]
}

model Venue {
  id         String   @id
  name       String
  address    String
  city       String
  state      String?
  country    String   @default("India")
  postalCode String?
  capacity   Int
  amenities  String?
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Event      Event[]
}

enum Role {
  USER
  ORGANIZER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  SUCCESS
  FAILED
  REFUNDED
  PENDING
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
}
